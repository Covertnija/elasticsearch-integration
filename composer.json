{
    "name": "covertnija/elasticsearch-integration",
    "version": "2.0.0",
    "description": "Symfony bundle for Elasticsearch integration with round-robin load balancing",
    "type": "symfony-bundle",
    "license": "MIT",
    "keywords": ["symfony", "elasticsearch", "bundle", "search", "load-balancing"],
    "authors": [
        {
            "name": "Domas Vysockis",
            "email": "leecher582@gmail.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "elastic/transport": "^9.0.1",
        "elasticsearch/elasticsearch": "^9.2",
        "monolog/monolog": "^3.3",
        "php-http/httplug": "^2.4",
        "psr/cache": "^2.0 || ^3.0",
        "psr/clock": "^1.0",
        "psr/http-client": "^1.0",
        "psr/http-message": "^2.0",
        "psr/log": "^3.0",
        "symfony/config": "^6.4 || ^7.0 || ^8.0",
        "symfony/dependency-injection": "^6.4 || ^7.0 || ^8.0",
        "symfony/http-client": "^6.4 || ^7.0 || ^8.0",
        "symfony/http-kernel": "^6.4 || ^7.0 || ^8.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^13.0",
        "roave/security-advisories": "dev-latest",
        "symfony/cache": "^6.4 || ^7.0 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "ElasticsearchIntegration\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ElasticsearchIntegration\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "check": [
            "@test",
            "@phpstan",
            "@cs-check"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
